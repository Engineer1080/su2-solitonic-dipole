// modules/coulomb.ddk — extract the soliton's effective charge (alpha_sol) from
// its near-field Coulomb tail.
//
// In the MTF the soliton is an electric charge: at large r its field is Coulomb,
// so the energy stored OUTSIDE radius R is
//     E_out(R) = (alpha_sol * hbar c / 2) / R
// hence  E_out(R) * R  is a plateau equal to alpha_sol*hbar c/2, and
//     alpha_sol^-1 = hbar c / (2 * E_out(R) * R).
// Operates on a precomputed density field + radius field, so it needs only the grid
// constants (the caller builds the soliton density via field.ddk + energy.ddk).
use constants

// Energy [MeV] outside radius R, summed over the interior (boundary shell dropped).
fn e_out(dens, rfield, R) {
    di = dens.narrow(0, 1, NX - 2).narrow(1, 1, NY - 2).narrow(2, 1, NZ - 2)
    ri = rfield.narrow(0, 1, NX - 2).narrow(1, 1, NY - 2).narrow(2, 1, NZ - 2)
    R_val = unwrap(R)
    mask = (ri > R_val) * 1.0
    A_val = unwrap(A)
    return Quantity((A_val * A_val * A_val) * (di * mask).sum(), "MeV")
}


// E_out(R)*R [MeV*fm]; equals alpha_sol*hbar c/2 on the Coulomb plateau.
fn coulomb_coeff(dens, rfield, R) {
    return e_out(dens, rfield, R) * R
}

// Inverse effective fine-structure constant from the tail at radius R.
fn alpha_inv_at(dens, rfield, R) {
    return HBARC / (2.0 * e_out(dens, rfield, R) * R)
}
