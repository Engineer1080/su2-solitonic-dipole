// experiments/exp_coulomb.ddk — recover the fine-structure constant from the
// single soliton's near-field Coulomb tail using differentiable curve-fitting.
use constants
use field
use energy
use coulomb

f = centered_soliton()
dens = energy_density(f[0], f[1], f[2], f[3])
rfield = center_radius()

print("R [fm] | E_out*R [MeV*fm] (CODATA-exact 0.720; measured ~0.66) | alpha_sol^-1 (CODATA 137.036)")
print("2.0 fm:")
print(coulomb_coeff(dens, rfield, 2.0[fm]))
print(alpha_inv_at(dens, rfield, 2.0[fm]))
print("3.0 fm:")
print(coulomb_coeff(dens, rfield, 3.0[fm]))
print(alpha_inv_at(dens, rfield, 3.0[fm]))
print("4.0 fm:")
print(coulomb_coeff(dens, rfield, 4.0[fm]))
print(alpha_inv_at(dens, rfield, 4.0[fm]))

// Showcase Dedekind's differentiable curve-fitting (autograd optimizer)
print("--- Fitting the Coulomb tail to E_out(R) = C/R ---")
Rs = [2.0, 2.5, 3.0, 3.5, 4.0]
Es = [
    unwrap(e_out(dens, rfield, 2.0[fm])),
    unwrap(e_out(dens, rfield, 2.5[fm])),
    unwrap(e_out(dens, rfield, 3.0[fm])),
    unwrap(e_out(dens, rfield, 3.5[fm])),
    unwrap(e_out(dens, rfield, 4.0[fm]))
]

fn fit_loss(params, data) {
    C = params[0]
    Rs = data[0]
    Es = data[1]
    diff = C / Rs - Es
    return (diff * diff).sum()
}

data = [Rs, Es]
params_init = [0.5]
params_opt = fit(fit_loss, params_init, data, method="gd", lr=0.1, steps=200)

C_opt = params_opt[0]
alpha_inv = unwrap(HBARC) / (2.0 * C_opt)

print("Optimized C (alpha_sol*hbar c/2) [MeV*fm] =")
print(C_opt)
print("Fitted alpha_sol^-1 =")
print(alpha_inv)

