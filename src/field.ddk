// modules/field.ddk — quaternion SU(2) field on a 3D Cartesian grid.
use constants

// Hedgehog soliton centered at lattice indices (cx,cy,cz); s = +1 soliton, -1 antisoliton.
// Returns [q0,q1,q2,q3], each shape (NX,NY,NZ). q0=cos(alpha), q_vec=sin(alpha)*s*n_hat,
// with the single-soliton profile alpha(r) = atan(r/R0).
fn hedgehog(cx, cy, cz, s) {
    A_val = unwrap(A)
    R0_val = unwrap(R0)
    xs = (arange(0.0, NXf, 1.0) - cx) * A_val
    ys = (arange(0.0, NYf, 1.0) - cy) * A_val
    zs = (arange(0.0, NZf, 1.0) - cz) * A_val
    x3 = xs.reshape(NX, 1, 1)
    y3 = ys.reshape(1, NY, 1)
    z3 = zs.reshape(1, 1, NZ)
    r  = sqrt(x3 * x3 + y3 * y3 + z3 * z3 + 1.0e-12)
    alpha = atan(r / R0_val)
    ca = cos(alpha)
    sa = sin(alpha)
    nx = x3 / r
    ny = y3 / r
    nz = z3 / r
    q0 = ca                        // already shape (NX,NY,NZ) via the r broadcast
    q1 = sa * s * nx
    q2 = sa * s * ny
    q3 = sa * s * nz
    return [q0, q1, q2, q3]
}

// A single soliton centered on the grid (s = +1).
fn centered_soliton() {
    return hedgehog((NXf - 1.0) / 2.0, (NYf - 1.0) / 2.0, (NZf - 1.0) / 2.0, 1.0)
}

// Radial distance [fm] from the grid center, shape (NX,NY,NZ).
fn center_radius() {
    A_val = unwrap(A)
    cx = (NXf - 1.0) / 2.0
    cy = (NYf - 1.0) / 2.0
    cz = (NZf - 1.0) / 2.0
    xs = ((arange(0.0, NXf, 1.0) - cx) * A_val).reshape(NX, 1, 1)
    ys = ((arange(0.0, NYf, 1.0) - cy) * A_val).reshape(1, NY, 1)
    zs = ((arange(0.0, NZf, 1.0) - cz) * A_val).reshape(1, 1, NZ)
    return sqrt(xs * xs + ys * ys + zs * zs + 1.0e-12)
}



