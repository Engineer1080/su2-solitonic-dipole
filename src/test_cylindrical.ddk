// Test script for 2D cylindrical coordinates
use constants

NX = 129
NY = 257  // We'll use NY as the z-dimension

A_val = 0.1 // spacing in fm

fn dd(q, dim) {
    return (q.roll(-1, dim) - q.roll(1, dim)) * (1.0 / (2.0 * A_val))
}

fn cross_sq(a, b) {
    Rx = a[1] * b[2] - a[2] * b[1]
    Ry = a[2] * b[0] - a[0] * b[2]
    Rz = a[0] * b[1] - a[1] * b[0]
    return Rx * Rx + Ry * Ry + Rz * Rz
}

fn test_energy() {
    R0_val = unwrap(R0)
    EPREF_CYL = unwrap(ALPHA_HBARC) / 2.0

    // Coordinates
    rhos = arange(0.0, 129.0, 1.0) * A_val
    zs = (arange(0.0, 257.0, 1.0) - 128.0) * A_val

    rho = rhos.reshape(129, 1)
    z = zs.reshape(1, 257)

    r = sqrt(rho * rho + z * z + 1e-12)
    alpha = atan(r / R0_val)

    q0 = cos(alpha)
    qr = sin(alpha) * (rho / r)
    qz = sin(alpha) * (z / r)

    // Derivatives along rho (dim=0)
    d0_0 = dd(q0, 0)
    dr_0 = dd(qr, 0)
    dz_0 = dd(qz, 0)

    // Derivatives along z (dim=1)
    d0_1 = dd(q0, 1)
    dr_1 = dd(qr, 1)
    dz_1 = dd(qz, 1)

    // Gamma_rho
    gr_x = q0 * dr_0 - d0_0 * qr
    gr_y = qz * dr_0 - qr * dz_0
    gr_z = q0 * dz_0 - d0_0 * qz
    gr = [gr_x, gr_y, gr_z]

    // Gamma_z
    gz_x = q0 * dr_1 - d0_1 * qr
    gz_y = qz * dr_1 - qr * dz_1
    gz_z = q0 * dz_1 - d0_1 * qz
    gz = [gz_x, gz_y, gz_z]

    // Gamma_phi
    inv_rho = 1.0 / (rho + 1e-12)
    gp_x = -qz * qr * inv_rho
    gp_y = q0 * qr * inv_rho
    gp_z = qr * qr * inv_rho
    gp = [gp_x, gp_y, gp_z]

    // Curvature sum
    curv = 0.5 * (cross_sq(gr, gz) + cross_sq(gr, gp) + cross_sq(gz, gp))

    q0sq = q0 * q0
    lam = (q0sq * q0sq * q0sq) / (R0_val * R0_val * R0_val * R0_val)

    dens = EPREF_CYL * (curv + lam)

    // Drop the boundaries
    dens_inner = dens.narrow(0, 1, 127).narrow(1, 1, 255)
    rho_inner = rho.narrow(0, 1, 127)

    E = (A_val * A_val) * (rho_inner * dens_inner).sum()
    print("2D Cylindrical grid Single Soliton Energy (a=0.1 fm) [MeV] =")
    print(E)
}

test_energy()
