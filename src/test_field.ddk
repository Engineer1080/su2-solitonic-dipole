use field
use constants

// A centered hedgehog must be unit-norm everywhere and have q0=cos(alpha):
// at the center r->0 => alpha->0 => q0->1.
f = hedgehog((NXf - 1.0) / 2.0, (NYf - 1.0) / 2.0, (NZf - 1.0) / 2.0, 1.0)
fn comp_norm(f) {
    q0 = f[0]
    q1 = f[1]
    q2 = f[2]
    q3 = f[3]
    return sqrt(q0 * q0 + q1 * q1 + q2 * q2 + q3 * q3)
}
nrm = comp_norm(f)
print("min norm:")
print(nrm.min())
print("max norm:")
print(nrm.max())
assert(nrm.min() > 0.99)
assert(nrm.max() < 1.01)

// q0 maximum should be ~1 (near the core)
print("max q0:")
print(f[0].max())
assert(f[0].max() > 0.95)
print("OK test_field")
